{
  "manifestVersion": 1,
  "id": "hana-proactive",
  "name": "Hana Proactive",
  "version": "0.1.0",
  "description": "让 Hana 在适当时机主动开口——检查不活跃状态，基于存在感级别自然发起对话",
  "trust": "full-access",
  "interface": {
    "displayName": "Hana Proactive",
    "shortDescription": "主动对话能力——定时检查状态，自然发起对话",
    "category": "Productivity"
  },
  "contributes": {
    "configuration": {
      "properties": {
        "presenceLevel": {
          "type": "string",
          "title": "存在感级别",
          "description": "控制主动的频率——低：2小时 / 中：30分钟 / 高：10分钟",
          "default": "medium",
          "enum": ["low", "medium", "high"],
          "enumDescriptions": ["低（2小时不活跃触发，少打扰）", "中（30分钟不活跃触发，平衡）", "高（10分钟不活跃触发，更积极）"],
          "ui": { "control": "select" }
        },
        "cooldownMinutes": {
          "type": "integer",
          "title": "冷却时间（分钟）",
          "description": "两次主动之间的最小间隔",
          "default": 15,
          "minimum": 5,
          "maximum": 120,
          "ui": { "control": "number" }
        },
        "maxMisses": {
          "type": "integer",
          "title": "最大连续未回复次数",
          "description": "超过此次数后自动静默，不再主动",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "ui": { "control": "number" }
        },
        "quietHoursEnabled": {
          "type": "boolean",
          "title": "夜间免打扰",
          "description": "开启后在指定时段内不主动触发",
          "default": false,
          "ui": { "control": "switch" }
        },
        "quietHoursStart": {
          "type": "integer",
          "title": "免打扰开始（小时）",
          "description": "0–23，例如 23 表示 23:00",
          "default": 23,
          "minimum": 0,
          "maximum": 23,
          "ui": { "control": "number" }
        },
        "quietHoursEnd": {
          "type": "integer",
          "title": "免打扰结束（小时）",
          "description": "0–23，例如 7 表示 07:00",
          "default": 7,
          "minimum": 0,
          "maximum": 23,
          "ui": { "control": "number" }
        }
      }
    }
  }
}
